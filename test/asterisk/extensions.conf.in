; extensions.conf for the app_amd_ws test harness (rendered by test/run.sh).
;
; Call model (SPEC section 9):
;   asterisk -rx 'channel originate Local/<NNNN>@farside-<scenario>/n extension <NNNN>@amdside-<scenario>'
;   - the Local ;2 leg runs [farside-<scenario>]: it answers and *plays* what
;     the callee would say (generated wav) and records what it *hears*
;     (MixMonitor/Record)
;   - once ;2 answers, the ;1 leg runs [amdside-<scenario>]: AMD_WS(...) then
;     the result line is written from the h extension, which runs on every
;     exit path (normal return, hangup, missing application).
;   VID = <NNNN>_<scenario>, unique per call.  run.sh generates one pair of
;   contexts per row of test/scenarios.txt; the extension pattern is _XXXX
;   (digits only - pbx.c treats n/x/z in a pattern as digit wildcards, so the
;   scenario name must never be part of a pattern).
;
; Results line (one per call, appended to ${RESULTS}):
;   VID|AMDSTATUS|AMDCAUSE|AMDELAPSED|T0|T1|TA|base64("x"+AMDRESPONSE)|CHANNEL
;   T0 = ms epoch just before the application, T1 = just after it returned
;   (or at hangup), TA = ms epoch when the farside started sending audio.
;   AMDRESPONSE is base64 encoded because it may contain quotes/JSON; the
;   leading "x" keeps BASE64_ENCODE happy when the variable is empty.

[globals]
RESULTS = @RESULTS@
REC = @REC@
MOCK_PORT = @MOCK_PORT@
DEAD_PORT = @DEAD_PORT@
TLS_PORT = @TLS_PORT@

; ---------------------------------------------------------------------------
; farside behaviours: Gosub(fs-<name>,s,1(<VID>,<scenario>,<NNNN>))
; Each one Answer()s (the originate proceeds on ANSWER), notes TA when its
; audio starts, and Return()s; the generated farside exten then Hangup()s.
; Note: Answer() on a ringing Local leg waits up to 500 ms for media from the
; other side before returning, so TA is ~500 ms after the amdside started
; unless the amdside is already playing something.
; ---------------------------------------------------------------------------

; 8 s of speech-like tone sweep: the normal "someone is talking" callee
[fs-speech8]
exten => s,1,Answer()
 same => n,Set(GLOBAL(TA_${ARG1})=${STRFTIME(,,%s%3q)})
 same => n,Playback(amd-speech8)
 same => n,Wait(2)
 same => n,Return()

; same, but records what it hears (r, S = pad with silence so the file is
; time-aligned with the call) and the mix, to prove parallel playback
[fs-speech8-mix]
exten => s,1,Answer()
 same => n,MixMonitor(${REC}/${ARG1}-mix.wav,Sr(${REC}/${ARG1}-heard.wav))
 same => n,Set(GLOBAL(TA_${ARG1})=${STRFTIME(,,%s%3q)})
 same => n,Playback(amd-speech8)
 same => n,Wait(2)
 same => n,StopMixMonitor()
 same => n,Return()

; 1.5 s of speech then hang up: the callee hangs up mid-detection
[fs-speech1500-hangup]
exten => s,1,Answer()
 same => n,Set(GLOBAL(TA_${ARG1})=${STRFTIME(,,%s%3q)})
 same => n,Playback(amd-speech1500)
 same => n,Return()

; answered but not a single audio frame (transmit_silence=no in asterisk.conf)
[fs-noaudio]
exten => s,1,Answer()
 same => n,Wait(8)
 same => n,Return()

; 8 s of digital silence frames (audio flows, but it is silent)
[fs-silence8]
exten => s,1,Answer()
 same => n,Set(GLOBAL(TA_${ARG1})=${STRFTIME(,,%s%3q)})
 same => n,Playback(amd-silence8)
 same => n,Return()

; records 3 s of what it hears with Record() (self-test: playback capture)
[fs-record3]
exten => s,1,Answer()
 same => n,Set(GLOBAL(TA_${ARG1})=${STRFTIME(,,%s%3q)})
 same => n,Record(${REC}/${ARG1}-heard.wav,0,3,qk)
 same => n,Return()

; does NOT answer; dials the amdside as a fresh, un-answered Local leg
; (for option A: AMD_WS must refuse with INTERR instead of answering)
[fs-dial-noanswer]
exten => s,1,Dial(Local/${ARG3}@amdside-${ARG2}/n,20)
 same => n,Return()

; ---------------------------------------------------------------------------
; result writer, called from the amdside h extension
; ---------------------------------------------------------------------------
[write-result]
exten => s,1,NoOp(write-result ${VID} status=${AMDSTATUS} cause=${AMDCAUSE})
 same => n,Set(T1=${IF($[${LEN(${T1})} = 0]?${STRFTIME(,,%s%3q)}:${T1})})
 same => n,Set(TA=${GLOBAL(TA_${VID})})
 same => n,Set(R64=${BASE64_ENCODE(x${AMDRESPONSE})})
 same => n,System(echo "${VID}|${AMDSTATUS}|${AMDCAUSE}|${AMDELAPSED}|${T0}|${T1}|${TA}|${R64}|${CHANNEL}" >> ${RESULTS})
 same => n,Return()

; ---------------------------------------------------------------------------
; [farside-<scenario>] and [amdside-<scenario>] are generated by run.sh below
; ---------------------------------------------------------------------------
