; amd_ws.conf for the app_amd_ws test harness (rendered by test/run.sh).
; Keys as in amd_ws.conf.sample.  The dialplan passes host, port, vid, timeout
; and options explicitly per call, so what matters here are the values the
; scenarios rely on:
;   connect_timeout_ms  -> server_down / slow_handshake timing bounds (2000 here
;                          instead of the production default 10000 to keep the
;                          suite short; opt_c_connto/blackhole pass c() anyway)
;   result_grace_ms     -> 0 = production default: SERVER_TIMEOUT exactly at timeout_ms
;   send_schedule/chunk_bytes/fallback_interval_ms -> protocol_test.py schedule assertions
;   eof_no_audio_streak/eof_wait_ms -> eof_human / eof_ack / eof_silent
;   send_caller_id      -> caller_id scenarios (flipped to no in the reload check)
;   db + astguiclient_conf -> DB-unreachable path (127.0.0.1:@DBPORT@ refused)
;   tls_cafile -> tls_human verifies the wss mock's self-signed certificate (option s)
;   max_pending_connects -> blackhole_cap (accept-and-never-reply peer, R1-1)
[general]
host = 127.0.0.1
port = @MOCK_PORT@
tls = no
tls_verify = yes
; the wss mock's self-signed certificate (generated by run.sh); chain verification stays ON
tls_cafile = @RUN@/etc/tls.crt
timeout_ms = 10000
connect_timeout_ms = 2000
result_grace_ms = 0
send_schedule = 500,1000,1500,2000,3000,4000,5000,6000,7000,8000,9000
chunk_bytes = 8000
fallback_interval_ms = 1000
eof_no_audio_streak = 2
eof_wait_ms = 3000
send_caller_id = yes
playdelay_ms = 0
db = yes
db_timeout_ms = 1000
astguiclient_conf = @RUN@/etc/astguiclient.conf
; per-host cap on connect helpers parked in the core's handshake read (blackhole + blackhole_fill park 8, blackhole_cap fails fast)
max_pending_connects = 8
