; amd_ws.conf for the app_amd_ws test harness (rendered by test/run.sh).
; Keys as in SPEC section 7 / amd_ws.conf.sample.  The dialplan passes host,
; port, vid, timeout and options explicitly per call, so what matters here
; are the values the scenarios rely on:
;   connect_timeout_ms  -> server_down / slow_handshake timing bounds
;   result_grace_ms     -> silent_server bound (timeout + grace +/- 300 ms)
;   send_schedule/chunk_bytes -> protocol_test.py schedule assertions
;   db + astguiclient_conf -> DB-unreachable path (127.0.0.1:@DBPORT@ refused)
;   tls_cafile -> tls_human verifies the wss mock's self-signed certificate (option s)
[general]
host = 127.0.0.1
port = @MOCK_PORT@
tls = no
tls_verify = yes
; the wss mock's self-signed certificate (generated by run.sh); chain verification stays ON
tls_cafile = @RUN@/etc/tls.crt
timeout_ms = 10000
connect_timeout_ms = 2000
result_grace_ms = 1000
send_schedule = 500,1000,1500,2000,3000,4000
chunk_bytes = 8000
extra_statuses = HONEYPOT,FAS,FASAMD,AUDIO,NOTSURE
playdelay_ms = 0
db = yes
db_timeout_ms = 1000
astguiclient_conf = @RUN@/etc/astguiclient.conf
