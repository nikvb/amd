; asterisk.conf for the app_amd_ws test harness (rendered by test/run.sh).
; Every directory lives under the scratch run dir @RUN@ (test/run/ast, gitignored)
; so the real 16.30.1-vici binary runs as an unprivileged user with no
; network listeners and without touching /etc/asterisk or /var/lib/asterisk.
; astrundir (CLI socket + pid file) is normally @RUN@/var/run too; run.sh moves
; it to a short $TMPDIR path when the checkout is so deep that the unix socket
; path would exceed the kernel's ~107 byte limit.
[directories]
astetcdir => @RUN@/etc
astmoddir => @RUN@/modules
astvarlibdir => @RUN@/var/lib
astdbdir => @RUN@/var/lib
astkeydir => @RUN@/var/lib
astdatadir => @RUN@/var/lib
astagidir => @RUN@/var/lib/agi-bin
astspooldir => @RUN@/var/spool
astrundir => @RUNDIR@
astlogdir => @LOGDIR@
astsbindir => /usr/sbin

[options]
verbose = 3
debug = 1
; do not fabricate audio: the "no audio" scenario relies on it
transmit_silence = no
hideconnect = yes
lockconfdir = no
systemname = amdtest
defaultlanguage = en
documentation_language = en_US
; a hung test must never leave a core file behind
dumpcore = no
